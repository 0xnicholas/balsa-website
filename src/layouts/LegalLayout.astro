---
// The legal pages' skeleton (SPEC §4.2): the H1, the one static `Last updated` line — a content
// string from src/content/legal-meta/, never a build-time date — then the locked paragraphs.
// One layout so the two stubs cannot drift apart.
import SegmentText, { type CopySegment } from '../components/SegmentText.astro';
import MarketingLayout from './MarketingLayout.astro';

export interface Props {
	title: string;
	description: string;
	h1: string;
	lastUpdated: string;
	paragraphs: readonly (readonly CopySegment[])[];
}

const { title, description, h1, lastUpdated, paragraphs } = Astro.props;
---
<MarketingLayout title={title} description={description}>
	<section data-legal-page class="px-6 py-16">
		<div class="mx-auto max-w-3xl">
			<h1 class="text-4xl font-semibold tracking-tight text-white sm:text-5xl">{h1}</h1>
			<p data-legal-updated class="mt-4 text-sm text-gray-3">Last updated: {lastUpdated}</p>
			<div data-legal-body class="mt-8 flex flex-col gap-4">
				{
					paragraphs.map((segments) => (
						<p class="leading-relaxed text-gray-2">
							<SegmentText segments={segments} />
						</p>
					))
				}
			</div>
		</div>
	</section>
</MarketingLayout>
