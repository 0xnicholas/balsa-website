---
// The keyword pages' skeleton (SPEC §4.4): the H1 (the keyword's face plus its claim), the 2–4
// argument sections (a subheading plus 1–3 sentences), exactly one `Learn more` text link —
// the pre-launch constant from `src/lib/links.ts` until the docs switch flips it — then the
// in-page FAQ (4–5 questions, zero overlap with the global nine, wearing its own
// `data-page-faq` marker so the §3.7 gate never claims it), the shared final CTA and the
// back-to-home anchor. One layout so the four pages cannot drift apart; no code blocks, no
// links between keyword pages, no breadcrumbs.
import { getEntry } from 'astro:content';
import FinalCta from '../components/FinalCta.astro';
import { learnMoreHref, type KeywordPageSlug } from '../lib/links.ts';
import MarketingLayout from './MarketingLayout.astro';

export interface KeywordSection {
	heading: string;
	body: string;
}

export interface KeywordFaqItem {
	question: string;
	answer: string;
}

export interface Props {
	title: string;
	description: string;
	slug: KeywordPageSlug;
	h1: string;
	sections: readonly KeywordSection[];
	faq: readonly KeywordFaqItem[];
	backAnchor: string;
}

const { title, description, slug, h1, sections, faq, backAnchor } = Astro.props;

const finalCta = await getEntry('finalCta', 'default');
if (!finalCta) {
	throw new Error('the keyword pages need the shared final CTA (SPEC §3.8/§4.4)');
}
---
<MarketingLayout title={title} description={description}>
	<section data-keyword-hero class="px-6 py-16">
		<div class="mx-auto max-w-3xl">
			<h1 class="text-4xl font-semibold tracking-tight text-white sm:text-5xl">{h1}</h1>
		</div>
	</section>
	<section data-keyword-sections class="border-t border-gray-5 px-6 py-20">
		<div class="mx-auto flex max-w-3xl flex-col gap-12">
			{
				sections.map((section) => (
					<article data-keyword-section>
						<h2 class="text-2xl font-semibold tracking-tight text-white">{section.heading}</h2>
						<p class="mt-3 leading-relaxed text-gray-2">{section.body}</p>
					</article>
				))
			}
			<p data-keyword-learn-more class="leading-relaxed">
				<a href={learnMoreHref(slug)} class="rounded-sm font-medium text-text-accent hover:underline">Learn more</a>
			</p>
		</div>
	</section>
	<section data-page-faq class="border-t border-gray-5 px-6 py-20">
		<div class="mx-auto max-w-3xl">
			<h2 class="text-3xl font-semibold tracking-tight text-white">Frequently asked questions</h2>
			<div class="mt-8 divide-y divide-gray-5 border-y border-gray-5">
				{
					faq.map((item) => (
						<details>
							<summary class="cursor-pointer py-4 font-medium text-white hover:text-text-accent">{item.question}</summary>
							<p class="pb-4 text-sm leading-relaxed text-gray-2">{item.answer}</p>
						</details>
					))
				}
			</div>
		</div>
	</section>
	<FinalCta heading={finalCta.data.heading} sub={finalCta.data.sub} />
	<section data-keyword-back class="border-t border-gray-5 px-6 py-12">
		<div class="mx-auto max-w-3xl">
			<a href={backAnchor} class="rounded-sm text-sm font-medium text-text-accent hover:underline">See how it works →</a>
		</div>
	</section>
</MarketingLayout>
