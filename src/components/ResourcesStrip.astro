---
// The resources strip (SPEC §3.6): one thin band — the `Go deeper` kicker and three links, each
// targeting its `src/lib/links.ts` constant so the docs switch point stays one edit. No second
// line of copy, no CTA.
import { LINKS, type ResourceLinkKey } from '../lib/links.ts';

export interface Props {
	kicker: string;
	links: readonly { label: string; key: ResourceLinkKey }[];
}

const { kicker, links } = Astro.props;
---
<section id="resources" data-resources class="scroll-mt-20 border-t border-gray-5 px-6 py-10">
	<div class="mx-auto flex max-w-5xl flex-wrap items-center justify-center gap-x-6 gap-y-2 text-sm">
		<p class="font-medium tracking-wide text-text-accent">{kicker}</p>
		<ul class="flex flex-wrap items-center justify-center gap-x-6 gap-y-2">
			{
				links.map((link) => (
					<li>
						<a href={LINKS[link.key]} class="rounded-sm text-gray-2 hover:text-white">{link.label}</a>
					</li>
				))
			}
		</ul>
	</div>
</section>
