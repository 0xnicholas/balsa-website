---
// The card's success glyph: shown for `copiedMs` after a copy (SPEC §6.1). Decorative — the
// button's own label carries the state.
interface Props {
	[key: string]: unknown;
}
const { ...rest } = Astro.props;
---
<svg
	class="size-4 shrink-0"
	viewBox="0 0 16 16"
	fill="none"
	stroke="currentColor"
	stroke-width="1.5"
	stroke-linecap="round"
	stroke-linejoin="round"
	aria-hidden="true"
	{...rest}
>
	<path d="M3 8.5 6.5 12 13 4.5" />
</svg>
