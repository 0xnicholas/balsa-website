---
// The trace waterfall (SPEC §7.5): a real run's static capture — the card head meta, one row
// per span (lane, its 0–100% bar, the right-hand value) and the card foot summary. Accent bars
// for ordinary spans, the site's trace-green for tool rows; the green is declared here and
// nowhere else (it does not spread into the brand palette).
export type TraceRow = {
	lane: string;
	left: number;
	width: number;
	value: string;
	tone: 'accent' | 'tool';
};

export interface Props {
	meta: string;
	rows: readonly TraceRow[];
	summary: string;
}

const { meta, rows, summary } = Astro.props;
---
<div class="trace" data-trace>
	<p class="trace-meta font-mono text-xs text-gray-3">{meta}</p>
	<ul class="mt-3 flex min-w-[20rem] flex-col gap-2">
		{
			rows.map((row) => (
				<li class="grid grid-cols-[minmax(7.5rem,auto)_1fr_auto] items-center gap-3" data-trace-row data-tone={row.tone}>
					<span class="truncate font-mono text-xs text-gray-2">{row.lane}</span>
					<span class="relative h-1.5 rounded-full bg-gray-6">
						<span class="trace-bar absolute inset-y-0 rounded-full" style={`left:${row.left}%;width:${row.width}%`} />
					</span>
					<span class="text-right font-mono text-xs text-gray-3">{row.value}</span>
				</li>
			))
		}
	</ul>
	<p class="trace-summary mt-4 font-mono text-xs text-gray-3">{summary}</p>
</div>

<style>
	.trace {
		/* SPEC §7.5 轨迹绿: the site's own auxiliary colour, for tool / nested spans only. */
		--trace-green: hsl(140, 45%, 32%);
	}

	@media (prefers-color-scheme: dark) {
		.trace {
			--trace-green: hsl(140, 40%, 55%);
		}
	}

	[data-tone='accent'] .trace-bar {
		background-color: var(--sl-color-accent);
	}

	[data-tone='tool'] .trace-bar {
		background-color: var(--trace-green);
	}
</style>
