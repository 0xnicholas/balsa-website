---
// The social-proof placeholder band (SPEC §3.4): a quiet banner — the `In the open` kicker and one
// muted line, and on purpose nothing else. No logos, quotes, ratings, counts, cases or CTA until
// there are real stories to tell; the band is the honest placeholder, not a slot for invented ones.
export interface Props {
	kicker: string;
	line: string;
}

const { kicker, line } = Astro.props;
---
<section id="social-proof" data-social-proof class="scroll-mt-20 border-t border-gray-5 px-6 py-16">
	<div class="mx-auto max-w-3xl text-center">
		<p class="text-sm font-medium tracking-wide text-text-accent">{kicker}</p>
		<p class="mt-4 text-sm leading-relaxed text-gray-3">{line}</p>
	</div>
</section>
