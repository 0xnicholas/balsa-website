---
// The use-case pages' shared header art (SPEC §4.3): one abstract banner all three pages
// render — a warm-paper base with amber orbit / span geometry, no copy, no logo, no
// third-party name. Pure decoration, painted with the §5.1 tokens, so light and dark both
// follow the OS preference like the rest of the site.
---
<figure data-use-case-art aria-hidden="true">
	<svg viewBox="0 0 1600 600" class="block h-auto w-full">
		<rect width="1600" height="600" fill="var(--sl-color-gray-6)" />
		<circle cx="800" cy="300" r="96" fill="none" stroke="var(--sl-color-gray-5)" stroke-width="1.5" />
		<circle cx="800" cy="300" r="176" fill="none" stroke="var(--sl-color-gray-5)" stroke-width="1.5" />
		<circle cx="800" cy="300" r="256" fill="none" stroke="var(--sl-color-gray-5)" stroke-width="1.5" stroke-opacity="0.75" />
		<circle cx="800" cy="300" r="336" fill="none" stroke="var(--sl-color-gray-5)" stroke-width="1.5" stroke-opacity="0.5" />
		<circle cx="800" cy="300" r="416" fill="none" stroke="var(--sl-color-gray-5)" stroke-width="1.5" stroke-opacity="0.3" />
		<path
			d="M 959.5 225.6 A 176 176 0 0 1 874.4 459.5"
			fill="none"
			stroke="var(--sl-color-accent)"
			stroke-width="4"
			stroke-linecap="round"
		/>
		<path
			d="M 603.8 464.6 A 256 256 0 0 1 619 119"
			fill="none"
			stroke="var(--sl-color-accent)"
			stroke-width="4"
			stroke-linecap="round"
			stroke-opacity="0.55"
		/>
		<path
			d="M 707.3 275.2 A 96 96 0 0 1 873.5 238.3"
			fill="none"
			stroke="var(--sl-color-accent)"
			stroke-width="4"
			stroke-linecap="round"
			stroke-opacity="0.3"
		/>
		<circle cx="800" cy="300" r="8" fill="var(--sl-color-accent)" />
		<circle cx="959.5" cy="225.6" r="5" fill="var(--sl-color-accent)" />
		<circle cx="874.4" cy="459.5" r="5" fill="var(--sl-color-accent)" />
		<circle cx="603.8" cy="464.6" r="4" fill="var(--sl-color-accent)" fill-opacity="0.55" />
		<circle cx="619" cy="119" r="4" fill="var(--sl-color-accent)" fill-opacity="0.55" />
		<circle cx="1104.5" cy="442" r="4" fill="var(--sl-color-accent)" fill-opacity="0.7" />
		<circle cx="398.2" cy="407.7" r="3.5" fill="var(--sl-color-accent)" fill-opacity="0.45" />
	</svg>
</figure>
