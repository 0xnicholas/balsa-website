---
// The global FAQ ×9 (SPEC §3.7): a semantic <details> list — one <summary> per question, the
// answer the only other child, keyboard operable with no script. The home page and the use-case
// pages render this one component over the same `faq` collection entries, so the nine questions
// exist once (SPEC §4.3). Answers carry no links.
export interface FaqItem {
	question: string;
	answer: string;
}

export interface Props {
	items: readonly FaqItem[];
}

const { items } = Astro.props;
const heading = 'Frequently asked questions';
---
<section id="faq" data-faq class="scroll-mt-20 border-t border-gray-5 px-6 py-20">
	<div class="mx-auto max-w-3xl">
		<h2 class="text-3xl font-semibold tracking-tight text-white">{heading}</h2>
		<div class="mt-8 divide-y divide-gray-5 border-y border-gray-5">
			{
				items.map((item) => (
					<details>
						<summary class="cursor-pointer py-4 font-medium text-white hover:text-text-accent">{item.question}</summary>
						<p class="pb-4 text-sm leading-relaxed text-gray-2">{item.answer}</p>
					</details>
				))
			}
		</div>
	</div>
</section>
