---
// The host-interface mocks' window frame (SPEC §3.5): the hero product window's component
// language — the same rounded `gray-5` frame, `gray-7` / `gray-6` surface and three dots —
// shared by all three mocks. Neutral chrome only: no product name, no session title, no label.
---
<div class="overflow-hidden rounded-xl border border-gray-5 bg-gray-7 dark:bg-gray-6" data-mock-window>
	<div class="flex items-center gap-3 border-b border-gray-5 px-4 py-2.5" data-mock-bar>
		<span class="flex gap-1.5" aria-hidden="true">
			<i class="size-2.5 rounded-full bg-gray-5"></i>
			<i class="size-2.5 rounded-full bg-gray-5"></i>
			<i class="size-2.5 rounded-full bg-gray-5"></i>
		</span>
	</div>
	<slot />
</div>
