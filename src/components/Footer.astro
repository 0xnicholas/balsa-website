---
// The one footer every page carries (SPEC §2.3): brand block → four columns → legal row.
// No newsletter slot, no social column, no status line; the external targets are the links
// constants, so the docs switch point stays one edit. The tagline comes from `src/lib/brand.ts`,
// split at its sentence boundary for the two-line brand-block typography.
import { publicTagline } from '../lib/brand.ts';
import { footerColumns } from '../lib/navigation.ts';

const [taglineLead, ...taglineRest] = publicTagline.split('. ');
---
<footer class="mt-24 border-t border-gray-5">
	<div class="mx-auto grid max-w-6xl gap-10 px-6 py-12 md:grid-cols-[minmax(0,1.4fr)_repeat(4,minmax(0,1fr))]">
		<div class="max-w-xs">
			<a href="/" class="rounded-sm text-lg font-semibold tracking-tight text-white">Balsats</a>
			<p class="mt-3 text-sm leading-relaxed text-gray-2">
				<span class="font-medium">{taglineLead}.</span><br />
				{taglineRest.join('. ')}
			</p>
		</div>
		{footerColumns.map((column) => (
			<nav aria-label={column.heading}>
				<h2 class="text-sm font-semibold text-white">{column.heading}</h2>
				<ul class="mt-3 flex flex-col gap-2">
					{column.items.map((item) => (
						<li>
							<a href={item.href} class="rounded-sm text-sm text-gray-2 hover:text-white">{item.label}</a>
						</li>
					))}
				</ul>
			</nav>
		))}
	</div>
	<div class="mx-auto flex max-w-6xl flex-wrap items-center gap-x-3 gap-y-2 border-t border-gray-5 px-6 py-6 text-sm text-gray-3">
		<span>© 2026 Balsats · Apache-2.0</span>
		<span aria-hidden="true">·</span>
		<a href="/privacy-policy/" class="rounded-sm hover:text-white">Privacy</a>
		<span aria-hidden="true">·</span>
		<a href="/terms-of-service/" class="rounded-sm hover:text-white">Terms</a>
	</div>
</footer>
