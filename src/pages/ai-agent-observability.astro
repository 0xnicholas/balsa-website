---
// /ai-agent-observability (SPEC §4.4): the observability keyword page — H1, the three argument
// sections, the `Learn more` link, the in-page FAQ ×5 and the `/#observability` back anchor,
// every string verbatim from the collection entry. Head copy is the §2.6 row.
import { getEntry } from 'astro:content';
import KeywordLayout from '../layouts/KeywordLayout.astro';

const entry = await getEntry('keywordPages', 'ai-agent-observability');
if (!entry) {
	throw new Error('/ai-agent-observability needs its §4.4 copy in src/content/keyword-pages/');
}
---
<KeywordLayout
	title={entry.data.title}
	description={entry.data.description}
	slug={entry.data.learnMore}
	h1={entry.data.h1}
	sections={entry.data.sections}
	faq={entry.data.faq}
	backAnchor={entry.data.backAnchor}
/>
