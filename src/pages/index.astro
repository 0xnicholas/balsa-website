---
// The green-skeleton home page (#19): the wordmark and the public tagline (SPEC §2.3, 【终稿·勿改】)
// on the brand token layer, in both themes. The header, footer and hero land in slices 02/03.
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout
	title="Balsats — ultralight TypeScript AI agent framework"
	description="Balsats is an ultralight TypeScript agent framework: compose only what you use, run anywhere, with zero runtime dependencies."
>
	<header class="px-6 py-8">
		<a href="/" class="text-xl font-semibold tracking-tight text-white">Balsats</a>
	</header>
	<main class="px-6 py-16">
		<p class="max-w-prose text-lg leading-relaxed">
			Ultralight TypeScript agent framework. Compose only what you use — run anywhere, no runtime baggage.
		</p>
	</main>
</BaseLayout>
