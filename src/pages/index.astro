---
// The home page. It carries the shell plus the public tagline until the hero lands in slice
// 03 (#21); the §2.6 title and description are already the locked values.
import { publicTagline } from '../lib/brand.ts';
import MarketingLayout from '../layouts/MarketingLayout.astro';
---
