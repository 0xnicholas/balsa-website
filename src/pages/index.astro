---
// The home page: hero → feature tabs → the shared final CTA today; observability, social proof,
// use-case cards, resources strip and FAQ land in slices 05–07 (#23–#25). Section order is fixed
// by SPEC §3 — insert the coming sections in place.
import { getCollection, getEntry } from 'astro:content';
import FeatureTabs from '../components/FeatureTabs.astro';
import FinalCta from '../components/FinalCta.astro';
import Hero from '../components/Hero.astro';
import MarketingLayout from '../layouts/MarketingLayout.astro';

const hero = await getEntry('hero', 'home');
const snippet = await getEntry('snippets', 'agent');
const trace = await getEntry('traces', 'hero');
const finalCta = await getEntry('finalCta', 'default');
const features = (await getCollection('features')).sort((a, b) => a.data.order - b.data.order);
if (!hero || !snippet || !trace || !finalCta || features.length !== 5) {
	throw new Error('the home page needs its content entries (SPEC §3.1 / §3.2 / §3.8 / §7.2 / §7.5)');
}
---
<MarketingLayout
	title="Balsats — ultralight TypeScript AI agent framework"
	description="Balsats is an ultralight TypeScript agent framework: compose only what you use, run anywhere, with zero runtime dependencies."
>
	<Hero
		h1={hero.data.h1}
		sub={hero.data.sub}
		file={snippet.data.file}
		code={snippet.data.code}
		trace={trace.data}
	/>
	<FeatureTabs features={features.map((entry) => ({ id: entry.id, ...entry.data }))} />
	<FinalCta heading={finalCta.data.heading} sub={finalCta.data.sub} />
</MarketingLayout>
