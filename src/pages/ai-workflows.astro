---
// /ai-workflows (SPEC §4.4): the workflows keyword page — H1, the four argument sections, the
// `Learn more` link, the in-page FAQ ×5 and the `/#workflows` back anchor, every string
// verbatim from the collection entry. Head copy is the §2.6 row.
import { getEntry } from 'astro:content';
import KeywordLayout from '../layouts/KeywordLayout.astro';

const entry = await getEntry('keywordPages', 'ai-workflows');
if (!entry) {
	throw new Error('/ai-workflows needs its §4.4 copy in src/content/keyword-pages/');
}
---
<KeywordLayout
	title={entry.data.title}
	description={entry.data.description}
	slug={entry.data.learnMore}
	h1={entry.data.h1}
	sections={entry.data.sections}
	faq={entry.data.faq}
	backAnchor={entry.data.backAnchor}
/>
