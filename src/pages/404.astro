---
// SPEC §2.8: the default minimal 404 — the sentence and one way home. It deliberately keeps
// no header, no footer and no docs / GitHub entry: an error page has nothing to navigate.
import '../styles/global.css';
---
<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>404 — Balsats</title>
	</head>
	<body class="bg-black font-sans text-gray-2">
		<main class="mx-auto flex max-w-6xl flex-col gap-4 px-6 py-24">
			<h1 class="text-2xl font-semibold tracking-tight text-white">404</h1>
			<p>This page doesn't exist. <a href="/" class="text-text-accent underline underline-offset-4">Head back home.</a></p>
		</main>
	</body>
</html>
